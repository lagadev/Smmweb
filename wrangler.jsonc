{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smm-api-center",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smm-api-center-db",
      "database_id": "1b10a468-8ce7-421b-afde-e7cfe9c125f3"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
